// Tang Nano 9K (GW1NR-LV9QN88PC6/I5) constraints for rtl/top.v
// Pin numbers verified on 2026-10-23 against two independent sources:
//   YosysHQ/apicula examples/tangnano9k.cst  (clk 52, led 10/11/13/14/15/16,
//                                             TXD 17 / RXD 18, keys 3 and 4)
//   sipeed/TangNano-9K-example uart/src/top.cst and led/src/9K_LED_project.cst
// UNVERIFIED: which pin is the "S1" vs "S2" silkscreen button. Sipeed's uart
// example uses pin 3 as rst_n, its led example uses pin 4 as sys_rst_n. Here
// pin 4 = reset and pin 3 = run demo; swap the two IO_LOC lines if needed.
// LEDs are active low (driven low = on). Bank voltages follow apicula's file.

IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "uart_txd" 17;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rxd" 18;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "btn_rst_n" 4;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn_run_n" 3;
IO_PORT "btn_run_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
