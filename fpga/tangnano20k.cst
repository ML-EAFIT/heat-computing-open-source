// Tang Nano 20K (GW2AR-LV18QN88C8/I7) constraints for fpga/tn20k_top.v
// Pin numbers checked on 2026-11-05 against two independent sources:
//   YosysHQ/apicula examples/tangnano20k.cst  (clk 4, led 15..20,
//                                              TXD 69 / RXD 70, keys 87 and 88)
//   sipeed/TangNano-20K-example uart/src/top.cst (clk 4, rst 88, tx 69, rx 70)
// Buttons are ACTIVE HIGH on the 20K (Sipeed: "wire rst_n = !rst"), unlike the
// 9K, so tn20k_top.v inverts them before rtl/top.v. Pin 88 = reset, pin 87 =
// run demo, following Sipeed's use of 88 as "rst"; swap if needed.
// LEDs are active low (driven low = on). All banks LVCMOS33.

IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "uart_txd" 69;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "uart_rxd" 70;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33;
IO_LOC  "btn_run" 87;
IO_PORT "btn_run" IO_TYPE=LVCMOS33;

IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
