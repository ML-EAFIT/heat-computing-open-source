    %vpi_call 2 55 "$display", "tb_uart: 256 bytes looped back, %0d errors", v0x555559ca3e60_0 {0 0 0};
    %load/vec4 v0x555559ca3e60_0;
    %cmpi/e 0, 0, 32;
    %flag_get/vec4 4;
    %jmp/0 T_9.12, 4;
    %load/vec4 v0x555559ca3f00_0;
    %cmpi/e 256, 0, 32;
    %flag_get/vec4 4;
    %and;
T_9.12;
    %flag_set/vec4 8;
    %jmp/0xz  T_9.10, 8;
    %vpi_call 2 56 "$display", "tb_uart: PASS" {0 0 0};
    %jmp T_9.11;
T_9.10 ;
    %vpi_call 2 57 "$display", "tb_uart: FAIL" {0 0 0};
T_9.11 ;
    %vpi_call 2 58 "$finish" {0 0 0};
    %end;
    .thread T_9;
